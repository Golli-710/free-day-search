# X API OAuth 1.0a user-context credentials. Keep real credentials out of Git.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Must be explicitly set to true before any live post can be created.
SOCIAL_POSTING_ENABLED=false

# Optional Search Console HTML verification code, supplied at build time.
GOOGLE_SITE_VERIFICATION=

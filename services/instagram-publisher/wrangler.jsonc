{
  "name": "free-day-instagram-publisher",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "PUBLISH_ENABLED": "false",
    "IG_ACCOUNT_ID": "17841431324405680",
    "IG_USERNAME": "free_day_search",
    "GRAPH_VERSION": "v25.0",
    "PUBLIC_ORIGIN": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLISHER",
        "class_name": "Publisher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Publisher"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
